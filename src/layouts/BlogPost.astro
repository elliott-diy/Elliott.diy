---
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import { Image } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import TableOfContents from "../components/TableOfContents.astro";
import TagLink from "../components/TagLink.astro";
import LinkButton from "../components/LinkButton.astro";

type BlogPostData = CollectionEntry<"blog">["data"];
type Props = BlogPostData & {
  readTimeText: string;
  headings?: MarkdownHeading[];
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  heroImageAlt,
  tags,
  readTimeText,
  headings = [],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = heroImage ?? "/otter.webp";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  mainEntityOfPage: canonicalURL,
  url: canonicalURL,
  image: [new URL(typeof ogImage === "string" ? ogImage : ogImage.src, Astro.site).toString()],
  keywords: tags,
  author: { "@type": "Person", name: "Elliott", url: Astro.site?.toString() },
};

const shareLinks = [
  {
    label: "Hacker News",
    icon: "fa6-brands:hacker-news",
    href: `https://news.ycombinator.com/submitlink?u=${encodeURIComponent(canonicalURL)}&t=${encodeURIComponent(title)}`,
  },
  {
    label: "X",
    icon: "fa6-brands:x-twitter",
    href: `https://x.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(canonicalURL)}`,
  },
];
---

<BaseLayout
  title={title}
  description={description}
  image={ogImage}
  imageAlt={heroImageAlt}
  ogType="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate ?? pubDate}
  tags={tags}
>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article class="px-4">
    <div class="mb-6 flex justify-between text-xs font-medium tracking-wide text-gray-500 dark:text-neutral-400">
      <div class="flex flex-col gap-1">
        <FormattedDate date={pubDate} />
        {updatedDate && <p>Updated <FormattedDate date={updatedDate} /></p>}
      </div>
      <p>{readTimeText}</p>
    </div>

    <h1 class="mb-8 text-4xl font-bold text-neutral-900 md:text-5xl dark:text-neutral-100">
      {title}
    </h1>

    {
      heroImage && (
        <Image
          src={heroImage}
          width={1020}
          loading="eager"
          fetchpriority="high"
          alt={heroImageAlt ?? `Cover image for ${title}`}
          class="mb-10 w-full"
        />
      )
    }

    <TableOfContents headings={headings} />

    <div class="prose-content">
      <slot />
    </div>

    {
      tags.length > 0 && (
        <ul class="mt-8 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <li>
              <TagLink tag={tag} />
            </li>
          ))}
        </ul>
      )
    }

    <section class="mt-6 border-t border-neutral-200/70 pt-4 dark:border-neutral-700/70">
      <p class="mb-2 text-xs text-gray-500 dark:text-neutral-400">Share</p>
      <div class="flex flex-wrap gap-2">
        {
          shareLinks.map(({ label, icon, href }) => (
            <LinkButton href={href} icon={icon}>
              {label}
            </LinkButton>
          ))
        }
      </div>
    </section>

    <section class="giscus mt-10" aria-label="Comments"></section>
  </article>

  <script>
    import "../scripts/content";
  </script>

  <!-- Giscus is injected with the right theme up front instead of flashing light then switching. -->
  <script is:inline>
    (() => {
      const giscus = document.createElement("script");
      const attrs = {
        src: "https://giscus.app/client.js",
        "data-repo": "elliott-diy/elliott-diy",
        "data-repo-id": "R_kgDONWVN1g",
        "data-category": "Announcements",
        "data-category-id": "DIC_kwDONWVN1s4CqAS0",
        "data-mapping": "pathname",
        "data-strict": "0",
        "data-reactions-enabled": "1",
        "data-emit-metadata": "0",
        "data-input-position": "bottom",
        "data-theme": document.documentElement.classList.contains("dark") ? "transparent_dark" : "light",
        "data-lang": "en",
        "data-loading": "lazy",
        crossorigin: "anonymous",
      };
      Object.entries(attrs).forEach(([key, value]) => giscus.setAttribute(key, value));
      giscus.async = true;
      document.querySelector("section.giscus")?.appendChild(giscus);
    })();
  </script>
</BaseLayout>
