---
import type { ComponentProps } from 'astro/types'
import BaseHead from '../components/BaseHead.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

type Props = ComponentProps<typeof BaseHead>

const props = Astro.props
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead {...props} />
        <slot name="head" />
    </head>
    <body class="mx-auto flex min-h-dvh w-full max-w-screen-md flex-col text-neutral-800 transition-colors duration-300 dark:bg-neutral-800 dark:text-neutral-300">
        <a
            href="#main"
            class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:rounded-md focus:bg-accent focus:px-3 focus:py-2 focus:text-white"
        >
            Skip to content
        </a>
        <Header />
        <main id="main" class="flex-1">
            <slot />
        </main>
        <Footer />
    </body>
</html>
