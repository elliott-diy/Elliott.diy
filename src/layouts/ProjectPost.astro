---
import BaseLayout from './BaseLayout.astro'
import LinkButton from '../components/LinkButton.astro'

interface Props {
    title: string
    description: string
    heroImage?: string
    heroImageAlt?: string
    /** Source code URL, shown as a button under the title. */
    repo?: string
}

const { title, description, heroImage, heroImageAlt = '', repo } = Astro.props
---

<BaseLayout title={title} description={description}>
    <article class="px-4">
        <h1 class:list={['text-4xl font-bold text-neutral-900 md:text-5xl dark:text-neutral-100', repo ? 'mb-5' : 'mb-8']}>
            {title}
        </h1>
        {
            repo && (
                <LinkButton href={repo} icon="radix-icons:github-logo" class="mb-10">
                    Source
                </LinkButton>
            )
        }
        {
            heroImage && (
                <img
                    src={heroImage}
                    alt={heroImageAlt}
                    width={1020}
                    height={510}
                    class="mb-10 w-full"
                />
            )
        }
        <div class="prose-content">
            <slot />
        </div>
    </article>

    <script>
        import '../scripts/content'
    </script>
</BaseLayout>
