---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import ProjectListItem from "../../components/ProjectListItem.astro";
import { getSortedPosts } from "../../utils/posts";

const projects = await getSortedPosts("projects");
---

<BaseLayout
  title="Projects"
  description="A collection of tools, experiments, and side projects I've worked on as a cybersecurity student. Some were built for fun, some for CTFs, and a few turned out to be surprisingly useful."
>
  <PageIntro title="Projects">
    A collection of tools, experiments, and side projects I've built as a cybersecurity student. Some were for CTFs, some were random ideas that felt worth trying, and a few turned out to be surprisingly useful. For everything else I've worked on, check out my <a href="https://github.com/elliott-diy" class="underline underline-offset-4 hover:text-accent dark:hover:text-accent-light">GitHub</a>.
  </PageIntro>

  <ul class="mx-4 my-4 flex flex-col border-t border-neutral-200 dark:border-neutral-700">
    {projects.map((project) => <ProjectListItem project={project} />)}
  </ul>
</BaseLayout>
