---
import { render } from 'astro:content';
import ProjectPost from '../../layouts/ProjectPost.astro'
import Video from '../../components/Video.astro'
import { getSortedPosts } from '../../utils/posts'

export async function getStaticPaths() {
    const projects = await getSortedPosts('projects');
    return projects.map((project) => ({
        params: { slug: project.id },
        props: { project },
    }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<ProjectPost title={project.data.title} description={project.data.description} repo={project.data.repo}>
    <Content components={{ Video }} />
</ProjectPost>
