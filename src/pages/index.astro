---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import RecentPublications from "../components/RecentPublications.astro";
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="flex flex-col gap-4 px-4 md:my-10 md:px-16">
    <h1 class="text-3xl font-bold text-neutral-900 md:text-5xl dark:text-neutral-100">
      <span aria-hidden="true">👋</span> Hey, I'm Elliott
    </h1>
    <p class="text-base leading-relaxed md:text-lg">
      I'm a cybersecurity student, builder, and reverse-engineering enthusiast. I like taking apart malware, designing CTFs, and experimenting with weird internet infrastructure.
    </p>
    <p class="text-base leading-relaxed md:text-lg">
      This site is a place to share projects, ideas, and things I find interesting. Some of it's useful. Some of it's just for fun.
    </p>
  </section>
  <RecentPublications />
</BaseLayout>
