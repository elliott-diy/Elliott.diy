---
interface Props {
    title: string
}

const { title } = Astro.props
---

<section class="px-4 pt-8 pb-6">
    <h1 class="mb-3 text-3xl font-bold text-neutral-900 dark:text-neutral-100">{title}</h1>
    <p class="text-base leading-relaxed text-neutral-600 dark:text-neutral-400">
        <slot />
    </p>
</section>
