---
import { Icon } from 'astro-iconify'

interface Props {
    href: string
    icon?: string
    class?: string
}

const { href, icon, class: className } = Astro.props
const external = /^https?:\/\//.test(href)
---

<a
    href={href}
    class:list={[
        'inline-flex items-center gap-1.5 rounded-md border border-neutral-300/80 px-2.5 py-1.5 text-xs text-neutral-600 transition-colors hover:bg-neutral-100/70 hover:no-underline dark:border-neutral-600/80 dark:text-neutral-300 dark:hover:bg-neutral-700/30',
        className,
    ]}
    {...external && { target: '_blank', rel: 'noopener noreferrer' }}
>
    {icon && <Icon name={icon} class="h-3.5 w-3.5" aria-hidden="true" />}
    <slot />
</a>
