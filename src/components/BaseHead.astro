---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { AUTHOR_NAME, AUTHOR_PATH, AUTHOR_SAME_AS, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: string | ImageMetadata;
	imageAlt?: string;
	ogType?: 'website' | 'article';
	publishedTime?: Date;
	modifiedTime?: Date;
	tags?: string[];
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
	title,
	description,
	image = '/otter.webp',
	imageAlt,
	ogType = 'website',
	publishedTime,
	modifiedTime,
	tags = [],
} = Astro.props;

// "Blog | Elliott.diy" in the tab, plain title for social cards.
const documentTitle = title === SITE_TITLE ? title : `${title} | ${SITE_TITLE}`;
const imagePath = typeof image === 'string' ? image : image.src;
const imageURL = new URL(imagePath, Astro.site).toString();
const siteURL = new URL('/', Astro.site).toString();
const personId = `${siteURL}#person`;
const websiteId = `${siteURL}#website`;
const authorURL = new URL(AUTHOR_PATH, Astro.site).toString();
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Person',
			'@id': personId,
			name: AUTHOR_NAME,
			url: authorURL,
			sameAs: AUTHOR_SAME_AS,
		},
		{
			'@type': 'WebSite',
			'@id': websiteId,
			name: SITE_TITLE,
			description: SITE_DESCRIPTION,
			url: siteURL,
			publisher: { '@id': personId },
		},
		...(ogType === 'article' && publishedTime ? [{
			'@type': 'BlogPosting',
			'@id': `${canonicalURL.toString()}#article`,
			headline: title,
			description,
			datePublished: publishedTime.toISOString(),
			dateModified: (modifiedTime ?? publishedTime).toISOString(),
			mainEntityOfPage: canonicalURL.toString(),
			url: canonicalURL.toString(),
			image: [imageURL],
			keywords: tags,
			author: { '@id': personId },
			isPartOf: { '@id': websiteId },
		}] : []),
	],
};
const jsonLd = JSON.stringify(structuredData).replace(/</g, '\\u003c');
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href="/favicon.ico" type="image/x-icon" sizes="16x16 32x32 48x48" />
<link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
<link rel="preload" href="/fonts/reddit-mono-v5-latin_latin-ext-regular.woff2" as="font" type="font/woff2" crossorigin />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#262626" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{documentTitle}</title>
<meta name="title" content={documentTitle} />
<meta name="description" content={description} />
<script is:inline type="application/ld+json" set:html={jsonLd} />

<!-- RSS Feed -->
<link href="/rss.xml" type="application/rss+xml" rel="alternate" title={SITE_TITLE} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
{imageAlt && <meta property="og:image:alt" content={imageAlt} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
{imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}

{
	ogType === 'article' && publishedTime && (
		<meta property="article:published_time" content={publishedTime.toISOString()} />
	)
}
{
	ogType === 'article' && modifiedTime && (
		<meta property="article:modified_time" content={modifiedTime.toISOString()} />
	)
}
{ogType === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}
{ogType === 'article' && <meta property="article:author" content={authorURL} />}

<!-- Apply the theme before first paint. Only an explicit toggle is persisted,
     so visitors who never touch it keep following their OS setting. -->
<script is:inline>
	(() => {
		let stored = null;
		try {
			stored = localStorage.getItem('theme');
		} catch {}
		const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
		const isDark = stored ? stored === 'dark' : prefersDark;
		document.documentElement.classList.toggle('dark', isDark);
	})();
</script>
