---
import { Icon } from 'astro-iconify'
import { Astronav, MenuItems, MenuIcon } from 'astro-navbar'
import HeaderLink from './HeaderLink.astro'
import ThemeIcon from './ThemeIcon.astro'

const navLinks = [
    { href: '/about', label: 'About' },
    { href: '/blog', label: 'Blog' },
    { href: '/projects', label: 'Projects' },
]
---

<header class="mb-10 w-full gap-5 px-4 pt-2 pb-4 md:pt-10 lg:mb-20 lg:flex">
    <Astronav>
        <div class="flex w-full items-center justify-between border-b border-neutral-200 pb-4 lg:border-none lg:pb-0 dark:border-neutral-700">
            <a class="group flex items-center gap-2 text-xl font-semibold hover:no-underline" href="/">
                <Icon name="fluent-emoji-flat:seal" class="h-7 w-7 transition-transform group-hover:rotate-[17deg]" aria-hidden="true" />
                Elliott.diy
            </a>
            <div class="flex items-center justify-center gap-4 lg:hidden">
                <MenuIcon class="h-4 w-4 text-gray-800 dark:text-neutral-300" />
                <ThemeIcon class="w-10" />
            </div>
        </div>
        <MenuItems class="hidden lg:flex">
            <nav aria-label="Main">
                <ul class="mt-3 flex flex-col gap-3 border-b border-neutral-200 pb-4 lg:mt-0 lg:flex-row lg:items-center lg:gap-5 lg:border-b-0 lg:pb-0 dark:border-neutral-700">
                    {
                        navLinks.map(({ href, label }) => (
                            <li class="flex items-center">
                                <HeaderLink href={href}>{label}</HeaderLink>
                            </li>
                        ))
                    }
                    <li class="hidden lg:flex">
                        <ThemeIcon class="w-10" />
                    </li>
                </ul>
            </nav>
        </MenuItems>
    </Astronav>
</header>
