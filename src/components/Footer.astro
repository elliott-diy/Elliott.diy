---
import { Icon } from "astro-iconify";
import { SITE_TITLE } from "../consts";

const socials = [
  { label: "Discord", icon: "radix-icons:discord-logo", href: "https://discord.com/users/559055812438392834" },
  { label: "GitHub", icon: "radix-icons:github-logo", href: "https://github.com/elliott-diy" },
  { label: "Email", icon: "radix-icons:envelope-closed", href: "mailto:hey@elliott.diy" },
  { label: "RSS feed", icon: "tabler:rss", href: "/rss.xml" },
];

const pages = [
  { label: "About", href: "/about" },
  { label: "Blog", href: "/blog" },
  { label: "Projects", href: "/projects" },
  { label: "Tags", href: "/tags" },
];
---

<footer class="mx-4 mt-20 md:mt-36">
  <div class="mb-5 flex flex-col gap-4 border-b border-neutral-200 pb-8 lg:flex-row dark:border-neutral-700">
    <div class="w-full lg:w-2/3">
      <p class="text-lg font-bold">{SITE_TITLE}</p>
      <p class="text-sm">
        Powered by curiosity, coffee, and a bunch of half-finished ideas that somehow made it online.
      </p>
      <ul class="mt-3 flex gap-3">
        {
          socials.map(({ label, icon, href }) => {
            const external = href.startsWith("http");
            return (
              <li>
                <a
                  href={href}
                  aria-label={label}
                  title={label}
                  {...(external && { target: "_blank", rel: "noopener noreferrer" })}
                >
                  <Icon
                    name={icon}
                    class="h-5 w-5 text-gray-600 transition-colors hover:text-gray-900 dark:text-neutral-300 dark:hover:text-white"
                    aria-hidden="true"
                  />
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
    <nav class="mt-1 lg:ml-auto" aria-label="Footer">
      <p class="mb-3 text-base font-bold">Pages</p>
      <ul class="flex flex-col gap-2 text-sm">
        {
          pages.map(({ label, href }) => (
            <li>
              <a href={href}>{label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <p class="mb-10 text-sm font-medium">
    &copy; {new Date().getFullYear()} Elliott. All rights reserved.
  </p>
</footer>
<script is:inline defer src="https://track.elliott.diy/script.js" data-website-id="b3d8f430-7d09-4f3a-b670-b56a508562d7"></script>
