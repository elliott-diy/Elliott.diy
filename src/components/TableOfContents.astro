---
import type { MarkdownHeading } from 'astro'

interface Props {
    headings: MarkdownHeading[]
    /** Only render when a post has at least this many sections. */
    minSections?: number
}

const { headings, minSections = 3 } = Astro.props
const items = headings.filter(({ depth }) => depth === 2 || depth === 3)
const sectionCount = items.filter(({ depth }) => depth === 2).length
---

{
    sectionCount >= minSections && (
        <details class="toc mb-10 rounded-lg border border-neutral-200 px-4 py-3 text-sm dark:border-neutral-700">
            <summary class="cursor-pointer font-semibold text-neutral-900 select-none dark:text-neutral-100">
                On this page
            </summary>
            <ol class="mt-3 flex flex-col gap-1.5">
                {items.map(({ depth, slug, text }) => (
                    <li class:list={[depth === 3 && 'pl-4']}>
                        <a href={`#${slug}`} class="text-neutral-600 hover:text-accent dark:text-neutral-400 dark:hover:text-accent-light">
                            {text}
                        </a>
                    </li>
                ))}
            </ol>
        </details>
    )
}
