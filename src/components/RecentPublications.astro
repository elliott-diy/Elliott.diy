---
import { getSortedPosts } from "../utils/posts";
import PostListItem from "./PostListItem.astro";

const RECENT_POST_COUNT = 3;
const recentPosts = (await getSortedPosts()).slice(0, RECENT_POST_COUNT);
---

<section class="mt-16 flex flex-col gap-4 px-4 md:px-16">
  <h2 class="text-base font-medium">Recent Posts</h2>
  <ul class="flex flex-col gap-4">
    {recentPosts.map((post) => <PostListItem post={post} />)}
  </ul>
  <a
    class="mx-auto mt-12 flex h-8 w-full max-w-xs items-center justify-center rounded-lg border border-gray-200 bg-gray-100 text-xs font-medium text-gray-700 transition-colors ease-in-out hover:border-gray-300 hover:bg-gray-200 hover:no-underline dark:border-neutral-600 dark:bg-neutral-700 dark:text-neutral-300 dark:hover:bg-neutral-700/50 dark:hover:text-neutral-100"
    href="/blog">View all posts</a
  >
</section>
